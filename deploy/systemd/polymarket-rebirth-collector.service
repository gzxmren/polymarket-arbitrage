[Unit]
Description=Polymarket 重生采集器 · 一个采集周期(发现+轮询+结算守望+告警+每日compaction)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/xmren/.openclaw/workspace/polymarket-project/11-collector
Environment=PYTHONPATH=/home/xmren/.openclaw/workspace/polymarket-project/11-collector
# 2026-08-16:打开批量注册。逐个查 slug 实测 950~2350ms/个 → 180s 闸只做得了 ~76 个,
# 而实测到达率 p50=247 / max=657/轮 ⇒ 积压顶死 2000、每轮丢弃、35.7% 在成交的市场采不到。
# 批量查 condition_ids 实测 34ms/个 ⇒ 配额随之 100→2000(run_cycle.BATCH_MAX_NEW)。
# ⚠️ 回滚 = 删掉下面这一行(代码里默认是关的)。
Environment=REGISTER_BATCH=1
# 幂等(watermark 驱动),超时保护:单周期最长 15 分钟(= timer 间隔,不排队重叠)。
# 2026-08-04 从 480s 上调:当天 12 轮撞 480s 被 SIGTERM 杀,而被杀的是**已干完大半活**
# 的周期(块缓冲未 flush → 日志只剩一行空周期头,诊断信息全丢),纯亏。
# ⚠️ 此值是 alerts.CYCLE_BUDGET_S 的红线,两边必须一致 —— 由
#    10-tests/unit/test_cycle_budget.py::test_service_timeout_matches_python_budget 焊死。
TimeoutStartSec=900
ExecStart=/usr/bin/python3 /home/xmren/.openclaw/workspace/polymarket-project/11-collector/run_cycle.py
StandardOutput=append:/home/xmren/.openclaw/workspace/polymarket-project/11-collector/data/collector.log
StandardError=append:/home/xmren/.openclaw/workspace/polymarket-project/11-collector/data/collector.log

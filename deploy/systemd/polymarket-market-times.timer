[Unit]
Description=Polymarket 时间防火墙侧表回填 · 每小时一次,排在所有采集任务的空档里

[Timer]
# ⭐排班依据(实测,非拍脑袋):
#   采集器      :00/:15/:30/:45 起跑,**最坏 200s**(review 实测曾达 148s)→ :48.3 收工
#   回填清扫    :07/:22/:37/:52 起跑,时间闸 300s                      → :57 收工
#   ⇒ 空档 = :48.3 ~ :52(约 3.7 分钟)
#   本任务排在 :50(距采集器最坏收工 100s 余量),批数上限 20(最坏约 90s),
#   超时 100s ⇒ 最坏 :51.7 收工,离回填清扫 :52 仍有余量。
# ⚠️ 原定 :48 + 40 批被判据抓出两处问题:落在采集器忙区内、且跑不完会撞上 :52。
#    第一版判据写成了恒真式,把这两条都掩盖了(2026-08-26 review 抓到)。
# 三者抢同一条代理隧道,而 08-04 正是隧道被拖垮 12 轮被 systemd 杀。
OnCalendar=*:50
# ⭐机器休眠错过的那一轮必须补跑 —— 2026-07-06 的教训:
#   固定时间点的 cron 撞上 systemd suspend 会整轮漏跑。
Persistent=true
# 开机后 10 分钟再跑(让采集器先起来占住网络;侧表回填是可以等的那一个)
OnBootSec=10min

[Install]
WantedBy=timers.target

[Unit]
Description=Polymarket 回填清扫 · 每 15 分钟一次,排在采集器的空档里

[Timer]
# ⭐排班依据(实测,非拍脑袋):
#   采集器在 :00/:15/:30/:45 起跑,实测一轮 320~403s(约 5.5~6.7 分钟)
#   → 它大约在 :07 之前收工,下一轮 :15 才起来 ⇒ 空档 ≈ 8 分钟
#   回填时间闸 300s(5 分钟),排在 :07 → 约 :12 收工,离下一轮还有 3 分钟余量
# 即便排班算错,脚本还有两道保险:开工前判采集器在不在跑、跑的过程中每 25 个市场再判一次。
# 两者抢同一条代理隧道,而 08-04 正是被隧道拖垮 12 轮被 systemd 杀。
OnCalendar=*:7/15
Persistent=true
# 开机后 5 分钟再跑(让采集器先起来占住网络,回填是可以等的那一个)
OnBootSec=5min

[Install]
WantedBy=timers.target
